{
  "name": "peermeld-docs",
  "version": "0.0.14",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "serve out",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "generate:blog": "node scripts/generate-blog.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "pages:deploy": "npm run build && wrangler pages deploy out --project-name=peermeld-docs"
  },
  "dependencies": {
    "cnfast": "^0.1.0",
    "fumadocs-core": "16.14.3",
    "fumadocs-mdx": "15.2.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.14.3",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "takumi-js": "^2.5.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.25",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^3.114.17"
  },
  "description": "The official documentation and blog for Peermeld — the professional network for developers, designers, founders and creators. Built with Next.js 16 + Fumadocs, fully static export, 100+ SEO-optimized guides.",
  "author": "Peermeld",
  "homepage": "https://docs.peermeld.com",
  "keywords": [
    "peermeld",
    "documentation",
    "docs",
    "blog",
    "seo",
    "fumadocs",
    "nextjs"
  ]
}
